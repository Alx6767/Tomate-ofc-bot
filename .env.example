# ─────────────────────────────────────────────────────────────
#  Tomate ofc bot — configuración
#  Copia este archivo a `.env` y cambia lo que necesites.
#  Sin `.env` el bot arranca con estos mismos valores por defecto.
# ─────────────────────────────────────────────────────────────

# Tu número, con código de país y sin + ni espacios.
# Es el único que puede usar los comandos de dueño.
OWNER=5215512345678

# Moderadores (pueden usar comandos suaves de administración). Separados por coma.
MODS=

# Nombre y emoji del bot en el menú.
BOT_NAME=Tomate ofc bot
BOT_EMOJI=🍅

# Prefijos aceptados (el primero es el que se muestra en el menú).
PREFIXES=.,!,/

# Cómo se vincula: `qr` (escanea el código) o `code` (código de 8 caracteres).
PAIRING=qr

# Si usas `code`, pon aquí el número que se va a vincular.
# PAIRING_NUMBER=5215512345678
# Código fijo de 8 caracteres (opcional; si se deja vacío se genera solo).
# PAIRING_CODE=

# País para completar números locales de 10 dígitos (MX, CO, PE, AR, CL, ES, US).
COUNTRY=MX

# Zona horaria de los comandos de hora y clima.
TZ=America/Mexico_City

# Solo el dueño y los moderadores pueden usar el bot.
PRIVATE_MODE=false

# Anti-enlace y anti-spam en grupos.
ANTI_LINK=true
ANTI_SPAM=true

# Contenido adulto. Déjalo en false salvo que tu grupo sea de adultos.
NSFW=false

# Límite de comandos por minuto y por chat (0 lo desactiva).
RATE_LIMIT=25

# Botones interactivos (respuesta, enlace, copiar). Si el cliente que recibe no
# los acepta, el bot manda el mismo contenido como texto numerado.
BOTONES=true

# Claves de inteligencia artificial. Todas son opcionales: si falta una, los
# comandos de esa IA avisan y no inventan nada.
GEMINI_KEY=
GROQ_KEY=
OPENAI_KEY=

# Enlaces que salen en el menú y en botinfo.
CHANNEL=
GROUP=
REPO=https://github.com/Alx6767/Tomate-ofc-bot

# Carpetas (por defecto `sesion/` y `data/` dentro del proyecto).
SESSION_DIR=sesion
DATA_DIR=data
